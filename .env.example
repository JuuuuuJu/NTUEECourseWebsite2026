# Copy to .env on the server and replace every placeholder. Never commit .env.

# MongoDB database name used by the website.
MONGO_DBNAME=ntuee-course
# MongoDB root account. Only applied when the Mongo volume is first created;
# on an existing volume these must match the account already stored there.
MONGO_USERNAME=replace-with-mongo-user
MONGO_PASSWORD=replace-with-a-random-password

# Password for the first admin account B00000000. Used only when the database
# has no admin yet; ignored afterwards (change it later in the website).
ADMIN_INITIAL_PASSWORD=replace-with-a-random-password

# Key used to encrypt saved SMTP credentials for queued email jobs.
# Must be exactly 64 hex characters, e.g. from: openssl rand -hex 32
EMAIL_CREDENTIAL_KEY=replace-with-64-hex-characters
# Defaults shown in email templates.
WEBSITE_URL=https://course.ntuee.org/
CONTACT_EMAIL=ntueesaad2@gmail.com
